# Quick API base URL, used by the server functions only (never sent to the
# browser). Read from the server process environment; defaults to the dev
# server started by `make dev`. Both compose files set it to
# http://quick-api:8000 themselves.
QUICK_API_URL=http://localhost:8100

# Public hostname Caddy serves over HTTPS (docker-compose.yml only).
PORTAL_HOST=quick-portal-sandbox.duckdns.org
