# API_HOST is hard-coded in Caddy's environment (see docker-compose.yml). Caddy
# obtains the certificate and redirects HTTP to HTTPS automatically.
{$API_HOST} {
	# Must match Beacon's MAX_REQUEST_BODY_BYTES (default 1048576 bytes = 1MiB;
	# note 1MB is 1000000 bytes). Larger bodies get 413 before reaching Beacon.
	request_body {
		max_size 1MiB
	}
			# Only Cielo's notification webhook is public. Every other route (for
		# example GET /transactions, which Quick API reads over the private
		# network) returns 404 here, so new routes stay private by default.
		@cielo_notifications {
			method POST
			path /cielo/notifications
		}
		handle @cielo_notifications {
			reverse_proxy beacon:8000
		}
		respond 404
}
