# Copy to .env and fill in. Placeholders only: never commit a real .env.

# Shared secret Cielo sends in the X-Cielo-Webhook-Token header. Generate one
# with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# While empty, every notification is rejected with 401.
CIELO_WEBHOOK_TOKEN=

# SQLite database file. Relative paths resolve from the app directory (/app in
# the container, where ./data is bind mounted).
DATABASE_PATH=data/beacon.sqlite3

# Largest accepted request body in bytes (default 1 MiB). Larger bodies are
# rejected with 413 and not stored. Keep request_body max_size in the Caddyfile
# equal to this value.
MAX_REQUEST_BODY_BYTES=1048576

# Public hostname Caddy serves over HTTPS (docker-compose.yml only).
API_HOST=beacon.example.com
