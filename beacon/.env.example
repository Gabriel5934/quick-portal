# Shared secret Cielo sends in the X-Cielo-Webhook-Token header.
CIELO_WEBHOOK_TOKEN=

# Relative paths resolve from the container WORKDIR, we don't want that.
DATABASE_PATH=data/beacon.sqlite3

# Largest accepted request body in bytes (default 1 MiB). Matches max_size in the Caddyfile.
MAX_REQUEST_BODY_BYTES=1048576

# Public hostname Caddy serves over HTTPS (docker-compose.yml only).
API_HOST=beacon.example.com
