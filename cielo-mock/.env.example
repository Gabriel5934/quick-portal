# Host port that exposes the mock (the container always listens on 3000).
MOCK_CIELO_PORT=3001

# OAuth2 client credentials the token endpoint accepts. They must match the
# backend's CIELO_MERCHANT_ID and CIELO_CLIENT_SECRET.
MOCK_CIELO_MERCHANT_ID=00000000-0000-0000-0000-000000000000
MOCK_CIELO_CLIENT_SECRET=iiow2KG3AYZaH5IAv_6tspKK0lFXiHyrzvqQTATcqhI
# Lifetime of issued bearer tokens.
MOCK_CIELO_TOKEN_LIFETIME_SECONDS=1200

# Seller onboarding response: success, validation_error, server_error, or
# malformed_success.
MOCK_CIELO_ONBOARDING_MODE=success

# Onboarding notifications sent after each successful seller creation.
# Leave the URL empty to disable them.
MOCK_CIELO_NOTIFICATION_URL=http://web:8000/cielo/onboarding/notifications/
# Sent as X-Cielo-Webhook-Token; must match the backend's CIELO_WEBHOOK_TOKEN.
MOCK_CIELO_NOTIFICATION_TOKEN=BiOYxVEpVfYuIwlSWKSw3lJjcRED07QALqsgj3pyROc
# Seconds to wait before each notification.
MOCK_CIELO_NOTIFICATION_DELAY_SECONDS=5
# approved, kyc_rejected, bank_error, or under_analysis.
MOCK_CIELO_NOTIFICATION_SCENARIO=approved

# Transaction notifications sent by `npm run notify:transaction`. They reuse
# MOCK_CIELO_NOTIFICATION_TOKEN.
MOCK_CIELO_TRANSACTION_NOTIFICATION_URL=http://web:8000/cielo/transactions/notifications/
# MerchantId of generated transactions; set it to a seller's merchant ID.
MOCK_CIELO_TRANSACTION_MERCHANT_ID=00000000-0000-0000-0000-000000000000
