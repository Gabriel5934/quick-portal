{
  "name": "cielo-mock",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/server.ts",
    "start": "node --disable-warning=ExperimentalWarning dist/server.js",
    "notify:transaction": "node --disable-warning=ExperimentalWarning dist/scripts/send-transaction-notification.js",
    "seed:admin-business": "node --disable-warning=ExperimentalWarning dist/scripts/seed-admin-business.js"
  },
  "dependencies": {
    "express": "^5.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
