# Shared secret Cielo sends in the X-Cielo-Webhook-Token header.
CIELO_WEBHOOK_TOKEN=

# Shared secret Quick API sends in the X-Portal-Token header
PORTAL_TOKEN=

# Lightsail private IP of this instance. beacon/docker-compose.yml binds
# port 8000 to it, so Quick API can reach Beacon over the private network.
BEACON_PRIVATE_IP=
