# Copy to .env and fill in. Placeholders only: never commit a real .env.
# `make dev` (root Makefile) creates .env with a random JWT_SECRET instead.

# Signs access tokens (HS256). Required, at least 32 bytes; the app refuses to
# start otherwise. Generate one with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing it invalidates every outstanding access token (refresh tokens are
# unaffected).
JWT_SECRET=

# Serves /docs, /redoc and /openapi.json. The dev compose sets it to true.
API_DOCS_ENABLED=false

# SQLite database file. Relative paths resolve from the app directory (/app in
# the container, where ./data is bind mounted).
DATABASE_PATH=data/quick-api.sqlite3

# Token lifetimes in seconds: 5 minutes for access, 1 day for refresh.
ACCESS_TOKEN_TTL_SECONDS=300
REFRESH_TOKEN_TTL_SECONDS=86400

# Refresh cookie attributes. The dev compose sets COOKIE_SECURE=false for
# http://localhost. A frontend on another site needs COOKIE_SAMESITE=none,
# which requires COOKIE_SECURE=true.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Origins allowed to call the API with credentials, separated by spaces or
# commas.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Public hostname Caddy serves over HTTPS (docker-compose.yml only).
API_HOST=quick-api.example.com
