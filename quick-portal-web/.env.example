# Copy to .env for local development. Production values are passed as Docker
# build arguments instead (see Dockerfile and docker-compose.yml).

# Django API exposed through nginx.
VITE_API_BASE_URL=http://localhost:8080

# Sentry error monitoring, tracing and session replay. Leave empty to disable.
# Use the quick-portal-web project's DSN.
VITE_SENTRY_DSN=
# Defaults to the Vite mode (development or production) when empty.
VITE_SENTRY_ENVIRONMENT=
